    function vShuffle(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }
    // x0,y0: top-left of bounding box; w,h: dimensions of bounding box
    function randSites(x0, y0, w, h, n) {
      const pts = [];
      const cols = Math.max(2, Math.round(Math.sqrt(n * w / h)));
      const rows = Math.max(2, Math.round(Math.sqrt(n * h / w)));
      // 1. Loose grid with jitter
      for (let r = 0; r < rows; r++)
        for (let cc = 0; cc < cols; cc++) {
          pts.push([
            x0 + ((cc + Math.random()) * w) / cols,
            y0 + ((r + Math.random()) * h) / rows,
          ]);
        }
      // 2. Fully random scatter
      const scatter = Math.max(4, Math.round(n * 0.3));
      for (let i = 0; i < scatter; i++)
        pts.push([x0 + Math.random() * w, y0 + Math.random() * h]);
      // 3. A few tight clusters
      const numClusters = 1 + Math.floor(Math.random() * 3);
      for (let k = 0; k < numClusters; k++) {
        const cx = x0 + Math.random() * w, cy = y0 + Math.random() * h;
        const clusterSize = 2 + Math.floor(Math.random() * 3);
        for (let i = 0; i < clusterSize; i++) {
          pts.push([
            cx + (Math.random() - 0.5) * w * 0.15,
            cy + (Math.random() - 0.5) * h * 0.15,
          ]);
        }
      }
      // Shuffle and trim to n
      for (let i = pts.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pts[i], pts[j]] = [pts[j], pts[i]];
      }
      return pts.slice(0, n);
    }

    function clipHalf(poly, ax, ay, cv) {
      if (!poly.length) return poly;
      const out = [];
      for (let i = 0; i < poly.length; i++) {
        const a = poly[i],
          b = poly[(i + 1) % poly.length];
        const da = ax * a[0] + ay * a[1] - cv,
          db = ax * b[0] + ay * b[1] - cv;
        if (da <= 0) out.push(a);
        if ((da < 0 && db > 0) || (da > 0 && db < 0)) {
          const t = da / (da - db);
          out.push([a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])]);
        }
      }
      return out;
    }

    function cellPath(i, pts, n, bbox) {
      n = n || pts.length;
      if (!pts || !pts[i]) return "";
      const bx = bbox ? bbox.x : 0, by = bbox ? bbox.y : 0;
      const bw = bbox ? bbox.w : vW, bh = bbox ? bbox.h : vH;
      let cell = [
        [bx, by],
        [bx + bw, by],
        [bx + bw, by + bh],
        [bx, by + bh],
      ];
      for (let j = 0; j < n; j++) {
        if (j === i) continue;
        const mx = (pts[i][0] + pts[j][0]) / 2,
          my = (pts[i][1] + pts[j][1]) / 2;
        const ax = pts[j][0] - pts[i][0],
          ay = pts[j][1] - pts[i][1];
        cell = clipHalf(cell, ax, ay, ax * mx + ay * my);
        if (!cell.length) break;
      }
      if (!cell.length) return "";
      return (
        "M" +
        cell.map((p) => p[0].toFixed(1) + "," + p[1].toFixed(1)).join("L") +
        "Z"
      );
    }

    // Build a gold outline SVG filter
    function makeOutlineFilter(ns, id) {
      const f = document.createElementNS(ns, "filter");
      f.setAttribute("id", id);
      f.setAttribute("x", "-5%"); f.setAttribute("y", "-5%");
      f.setAttribute("width", "110%"); f.setAttribute("height", "110%");
      const dilate = document.createElementNS(ns, "feMorphology");
      dilate.setAttribute("in", "SourceAlpha");
      dilate.setAttribute("operator", "dilate");
      dilate.setAttribute("radius", "2");
      dilate.setAttribute("result", "dilated");
      f.appendChild(dilate);
      const xor = document.createElementNS(ns, "feComposite");
      xor.setAttribute("in", "dilated"); xor.setAttribute("in2", "SourceAlpha");
      xor.setAttribute("operator", "xor"); xor.setAttribute("result", "ring");
      f.appendChild(xor);
      const flood = document.createElementNS(ns, "feFlood");
      flood.setAttribute("flood-color", "#f0d399");
      flood.setAttribute("flood-opacity", "0.95");
      flood.setAttribute("result", "outlineColor");
      f.appendChild(flood);
      const col = document.createElementNS(ns, "feComposite");
      col.setAttribute("in", "outlineColor"); col.setAttribute("in2", "ring");
      col.setAttribute("operator", "in");
      f.appendChild(col);
      return f;
    }

    function initVoronoi() {
      const ns = "http://www.w3.org/2000/svg";
      if (!vSvg || !vSvg.parentElement) return false;
      vW = vSvg.parentElement.offsetWidth;
      vH = vSvg.parentElement.offsetHeight;
      if (!vW || !vH) return false;
      vSvg.setAttribute("viewBox", "0 0 " + vW + " " + vH);
      vSvg.innerHTML = "";
      vShapes = [];

      const defs = document.createElementNS(ns, "defs");
      const clip = document.createElementNS(ns, "clipPath");
      clip.setAttribute("id", "heroVoronoiClip");
      clip.setAttribute("clipPathUnits", "userSpaceOnUse");
      const clipRect = document.createElementNS(ns, "path");
      clipRect.setAttribute("d", "M0,0H" + vW + "V" + vH + "H0Z");
      clip.appendChild(clipRect);
      defs.appendChild(clip);

      const slotW = vW / 3;
      const slotH = vH;
      const slotPad = slotW * 0.08;

      function shapeTransform(si, shape) {
        const availW = slotW - slotPad * 2;
        const baseScale = Math.min(availW / shape.vbW, slotH / shape.vbH) * (shape.scale || 1);
        const sw = shape.vbW * baseScale, sh = shape.vbH * baseScale;
        const sx = (shape.x !== undefined ? (vW - sw) * shape.x / 100 : si * slotW + slotPad + (availW - sw) / 2);
        const sy = vH - sh - vH * (shape.y || 0) / 100;
        return "translate(" + sx.toFixed(2) + "," + sy.toFixed(2) + ") scale(" + baseScale.toFixed(4) + ")";
      }

      // Sort by z so higher z renders on top
      const sorted = SHAPES
        .map((shape, i) => ({shape, si: i}))
        .sort((a, b) => (a.shape.z || 0) - (b.shape.z || 0));


      // Build defs: mask + filter per shape
      sorted.forEach(({shape, si}) => {
        const transform = shapeTransform(si, shape);
        const mask = document.createElementNS(ns, "mask");
        mask.setAttribute("id", "heroMask" + si);
        mask.setAttribute("maskUnits", "userSpaceOnUse");
        mask.setAttribute("maskContentUnits", "userSpaceOnUse");
        mask.setAttribute("mask-type", "alpha");
        mask.setAttribute("x", "0"); mask.setAttribute("y", "0");
        mask.setAttribute("width", String(vW)); mask.setAttribute("height", String(vH));
        const maskPath = document.createElementNS(ns, "path");
        maskPath.setAttribute("d", shape.d);
        maskPath.setAttribute("fill", "white");
        maskPath.setAttribute("transform", transform);
        mask.appendChild(maskPath);
        defs.appendChild(mask);
        defs.appendChild(makeOutlineFilter(ns, "heroFilter" + si));
      });
      vSvg.appendChild(defs);

      // Render in z-order: backdrop, cells, outline
      sorted.forEach(({shape, si}) => {
        const transform = shapeTransform(si, shape);
        // Bounding box of rendered shape in panel space
        const _availW = slotW - slotPad * 2;
        const _bscale = Math.min(_availW / shape.vbW, slotH / shape.vbH) * (shape.scale || 1);
        const _sw = shape.vbW * _bscale, _sh = shape.vbH * _bscale;
        const _sx = (shape.x !== undefined ? (vW - _sw) * shape.x / 100 : si * slotW + slotPad + (_availW - _sw) / 2);
        const _sy = vH - _sh - vH * (shape.y || 0) / 100;
        const shapeBBox = {x: _sx, y: _sy, w: _sw, h: _sh};
        const shapeNCount = Math.max(4, shape.n || 30);
        const colors = vShuffle(
          Array.from({length: shapeNCount}, (_, i) => vPalette[i % vPalette.length])
        );

        const backdrop = document.createElementNS(ns, "rect");
        backdrop.setAttribute("x", "0"); backdrop.setAttribute("y", "0");
        backdrop.setAttribute("width", String(vW)); backdrop.setAttribute("height", String(vH));
        const zLevel = shape.z || 0;
        const bgGrey = 14 + zLevel * 3;
        backdrop.setAttribute("fill", `rgb(${bgGrey},${bgGrey - 1},${bgGrey - 3})`);
        backdrop.setAttribute("mask", "url(#heroMask" + si + ")");
        vSvg.appendChild(backdrop);

        const paths = [];
        for (let i = 0; i < shapeNCount; i++) {
          const p = document.createElementNS(ns, "path");
          p.setAttribute("class", "vcell");
          p.setAttribute("fill", "transparent");
          p.setAttribute("fill-opacity", "0");
          p.setAttribute("stroke", "#e7ecf410");
          p.setAttribute("stroke-width", "1");
          p.setAttribute("data-voronoi-shape", String(si));
          p.setAttribute("pointer-events", "all");
          p.setAttribute("clip-path", "url(#heroVoronoiClip)");
          p.setAttribute("mask", "url(#heroMask" + si + ")");
          vSvg.appendChild(p);
          paths.push(p);
        }

        const outlinePath = document.createElementNS(ns, "path");
        outlinePath.setAttribute("class", "voutline");
        outlinePath.setAttribute("d", shape.d);
        outlinePath.setAttribute("fill", "none");
        outlinePath.setAttribute("stroke", "#f0d39975");
        outlinePath.setAttribute("stroke-width", "1");
        outlinePath.setAttribute("vector-effect", "non-scaling-stroke");
        outlinePath.setAttribute("stroke-linejoin", "round");
        outlinePath.setAttribute("transform", transform);
        outlinePath.setAttribute("pointer-events", "none");
        vSvg.appendChild(outlinePath);

        // Keep hit geometry separate from visible outline. SVG hit-testing is
        // unreliable on paths styled with `fill: none` in some browsers.
        const hitRef = document.createElementNS(ns, "path");
        hitRef.setAttribute("d", shape.d);
        hitRef.setAttribute("fill", "transparent");
        hitRef.setAttribute("fill-opacity", "0");
        hitRef.setAttribute("transform", transform);
        hitRef.setAttribute("pointer-events", "none");
        vSvg.appendChild(hitRef);

        const sites = randSites(shapeBBox.x, shapeBBox.y, shapeBBox.w, shapeBBox.h, shapeNCount);
        const targets = sites.map((s) => [
          Math.max(shapeBBox.x, Math.min(shapeBBox.x + shapeBBox.w, s[0] + (Math.random() - 0.5) * shapeBBox.w * 0.18)),
          Math.max(shapeBBox.y, Math.min(shapeBBox.y + shapeBBox.h, s[1] + (Math.random() - 0.5) * shapeBBox.h * 0.18)),
        ]);
        for (let i = 0; i < shapeNCount; i++) {
          const pd = cellPath(i, sites, shapeNCount, shapeBBox);
          if (pd) paths[i].setAttribute("d", pd);
        }
        // Store si so we can look up the mask path for hit-testing
        const avgCellSide = Math.sqrt((shapeBBox.w * shapeBBox.h) / shapeNCount);
        const influenceR = Math.max(40, avgCellSide * 1.5);
        vShapes.push({si, n: shapeNCount, bbox: shapeBBox, influenceR, sites, targets, paths, colors, frame: 0, mouseX: -9999, mouseY: -9999, outlinePath: hitRef});
      });

      return true;
    }

    // INFLUENCE_R is now per-shape (vs.influenceR), computed from avg cell size
    const PUSH_STRENGTH = 0.18;

    const heroRight = document.querySelector(".hero-right");
    if (heroRight && vSvg) {
      vSvg.addEventListener("pointermove", (e) => {
        if (!vShapes.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const rect = vSvg.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        const hitCell = e.target instanceof Element
          ? e.target.closest("[data-voronoi-shape]")
          : null;
        const shapeId = hitCell?.getAttribute("data-voronoi-shape");
        let activeIdx = shapeId === null || shapeId === undefined
          ? -1
          : vShapes.findIndex((vs) => String(vs.si) === shapeId);

        // Some SVG engines do not dispatch events through masked transparent
        // cells. Fall back to rendered figure bounds for reliable hover color.
        if (activeIdx === -1) {
          for (let i = vShapes.length - 1; i >= 0; i--) {
            const {x, y, w, h} = vShapes[i].bbox;
            if (mx >= x && mx <= x + w && my >= y && my <= y + h) {
              activeIdx = i;
              break;
            }
          }
        }
        vShapes.forEach((vs, i) => {
          vs.mouseX = i === activeIdx ? mx : -9999;
          vs.mouseY = i === activeIdx ? my : -9999;
        });
      });
      vSvg.addEventListener("pointerleave", () => {
        vShapes.forEach((vs) => {vs.mouseX = -9999; vs.mouseY = -9999;});
      });
    }

    function frameVoronoi() {
      if (!voronoiStarted || !vShapes.length) return;
      vShapes.forEach((vs) => {
        vs.frame++;
        if (vs.frame >= MORPH_FRAMES) {
          vs.frame = 0;
          vs.sites = vs.targets.map((s) => [...s]);
          vs.targets = vs.sites.map((s) => [
            Math.max(vs.bbox.x, Math.min(vs.bbox.x + vs.bbox.w, s[0] + (Math.random() - 0.5) * vs.bbox.w * 0.18)),
            Math.max(vs.bbox.y, Math.min(vs.bbox.y + vs.bbox.h, s[1] + (Math.random() - 0.5) * vs.bbox.h * 0.18)),
          ]);
        }
        if (vs.frame % STEP === 0) {
          const et = easeInOut(vs.frame / MORPH_FRAMES);
          const cur = vs.sites.map((s, i) => {
            let x = lerp(s[0], vs.targets[i][0], et);
            let y = lerp(s[1], vs.targets[i][1], et);
            const dx = x - vs.mouseX, dy = y - vs.mouseY;
            const d = Math.sqrt(dx * dx + dy * dy);
            if (d < vs.influenceR && d > 0) {
              const force = (1 - d / vs.influenceR) * PUSH_STRENGTH;
              x += (dx / d) * vs.influenceR * force;
              y += (dy / d) * vs.influenceR * force;
              x = Math.max(vs.bbox.x, Math.min(vs.bbox.x + vs.bbox.w, x));
              y = Math.max(vs.bbox.y, Math.min(vs.bbox.y + vs.bbox.h, y));
            }
            return [x, y];
          });
          for (let i = 0; i < vs.n; i++) {
            if (!vs.paths[i] || !cur[i]) continue;
            const pd = cellPath(i, cur, vs.n, vs.bbox);
            if (pd) vs.paths[i].setAttribute("d", pd);
            const dx = cur[i][0] - vs.mouseX, dy = cur[i][1] - vs.mouseY;
            const dist = Math.sqrt(dx * dx + dy * dy);
            const isHovered = dist < vs.influenceR;
            const baseColor = vs.colors[i % vs.colors.length];
            vs.paths[i].setAttribute("stroke", isHovered ? baseColor : "#e7ecf410");
            vs.paths[i].setAttribute("fill", isHovered ? baseColor : "transparent");
            vs.paths[i].setAttribute("fill-opacity", isHovered ? "0.35" : "0");
          }
        }
      });
      requestAnimationFrame(frameVoronoi);
    }

    window.addEventListener("resize", () => {
      if (voronoiStarted) {
        initVoronoi();
      } else {
        tryStartVoronoi();
      }
    });

    function tryStartVoronoi() {
      if (voronoiStarted) return true;
      if (!initVoronoi()) return false;
      voronoiStarted = true;
      frameVoronoi();
      return true;
    }

    // Multiple boot hooks to avoid race conditions with late layout/font paint.
    requestAnimationFrame(tryStartVoronoi);
    setTimeout(tryStartVoronoi, 120);
    setTimeout(tryStartVoronoi, 320);
    window.addEventListener("load", tryStartVoronoi);
    window.addEventListener("pageshow", tryStartVoronoi);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) tryStartVoronoi();
    });

    // ── Scroll reveal ──
    const revealObs = typeof IntersectionObserver === "undefined" ? null : new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            revealObs.unobserve(entry.target);
          }
        });
      },
      {threshold: 0.1, rootMargin: "0px 0px -40px 0px"},
    );
    if (revealObs) {
      document
        .querySelectorAll(".reveal")
        .forEach((el) => revealObs.observe(el));
    }

    // ── Nav active state ──
    const navLinks = document.querySelectorAll(".nav-links a");
    const sectionObs = typeof IntersectionObserver === "undefined" ? null : new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((a) => {
              a.style.color =
                a.getAttribute("href") === "#" + entry.target.id
                  ? "var(--color-text-primary)"
                  : "";
            });
          }
        });
      },
      {threshold: 0.25},
    );
    if (sectionObs) {
      document
        .querySelectorAll("section[id]")
        .forEach((s) => sectionObs.observe(s));
    }
  </script>
</body>
</html>
