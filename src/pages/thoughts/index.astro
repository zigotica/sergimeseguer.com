---
import ThoughtsLayout from '../../layouts/ThoughtsLayout.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const description = 'Thoughts on engineering, products, and the craft of building well.';
---
<ThoughtsLayout
  title="Thoughts"
  description={description}
  canonical="https://sergimeseguer.com/thoughts/"
>
  <main>
    <header class="page-intro">
      <h1>Thoughts</h1>
      <p>{description}</p>
    </header>
    <section class="post-list" aria-label="Thoughts posts">
      {posts.length === 0 ? (
        <p>No thoughts published yet.</p>
      ) : (
        posts.map((post) => (
          <article class="post-card">
            <p class="post-meta"><time datetime={post.date}>{post.date}</time></p>
            <h2><a href={`/thoughts/${post.slug}/`}>{post.title}</a></h2>
            <p class="post-description">{post.description}</p>
          </article>
        ))
      )}
    </section>
  </main>
</ThoughtsLayout>
