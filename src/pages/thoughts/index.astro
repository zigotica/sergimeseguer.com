---
import ThoughtsLayout from '../../layouts/ThoughtsLayout.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const description = 'Thoughts on engineering, products, and the craft of building well.';
---
<ThoughtsLayout
  title="Thoughts"
  description={description}
  canonical="https://sergimeseguer.com/thoughts/"
>
  <section class="thoughts-index" aria-label="Thoughts posts">
    <div class="section-container">
        <div class="thoughts-post-list">
          {posts.length === 0 ? (
            <p class="exp-body">No thoughts published yet.</p>
          ) : (
            posts.map((post) => (
              <article class="thoughts-post-card">
                <p class="thoughts-entry-date"><time datetime={post.date}>{post.date}</time></p>
                <h2 class="thoughts-entry-title"><a href={`/thoughts/${post.slug}/`} set:html={post.titleHtml}></a></h2>
                <p class="thoughts-entry-description" set:html={post.descriptionHtml}></p>
                <a class="thoughts-entry-read-more" href={`/thoughts/${post.slug}/`}>Keep reading</a>
              </article>
            ))
          )}
        </div>
    </div>
  </section>
</ThoughtsLayout>
