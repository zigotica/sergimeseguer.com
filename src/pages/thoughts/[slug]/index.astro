---
import ThoughtsLayout from '../../../layouts/ThoughtsLayout.astro';
import { getPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const canonical = `https://sergimeseguer.com/thoughts/${post.slug}/`;
---
<ThoughtsLayout
  title={post.title}
  description={post.description}
  canonical={canonical}
  og={post.og}
  ogType="article"
  >
  <section>
    <article>
      <header>
          <p class="thoughts-entry-date"><time datetime={post.date}>{post.date}</time></p>
          <h1 class="thought-entry-title" set:html={post.titleHtml}></h1>
          <p class="thoughts-entry-description" set:html={post.descriptionHtml}></p>
        </header>
      <div class="post-body" set:html={post.html}></div>
    </article>
  </section>
</ThoughtsLayout>
