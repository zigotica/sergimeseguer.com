---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: 'website' | 'article';
}

const { title, description, canonical, ogType = 'website' } = Astro.props;
const siteName = 'Sergi Meseguer';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <link rel="alternate" type="application/rss+xml" title="Sergi Meseguer Thoughts RSS" href="/thoughts/rss.xml" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  </head>
  <body>
    <!-- generated: thoughts-blog-markdown -->
    <div class="thoughts-shell">
      <Header
        ariaLabel="Thoughts navigation"
        logoText="Sergi Meseguer"
        logoHref="/"
        showMark={false}
        links={[{ label: 'Thoughts', href: '/thoughts/' }]}
      />
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style>
  .thoughts-shell {
    width: min(44rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: calc(var(--menu-height) + var(--space-3)) 0 4rem;
  }

  .thoughts-shell section {
    padding: 0;
  }

  .thoughts-shell main {
    color: var(--color-text-primary);
  }

  .thoughts-shell a {
    color: var(--color-accent-gold);
  }

  .thoughts-shell .nav-logo {
    color: var(--color-accent-gold);
  }

  .thoughts-shell .nav-links a {
    color: var(--color-text-subtle);
  }

  .thoughts-shell .nav-links a:hover,
  .thoughts-shell .nav-links a:focus {
    color: var(--color-text-primary);
  }

  .thoughts-shell h1,
  .thoughts-shell h2,
  .thoughts-shell h3 {
    line-height: 1.15;
    font-weight: 400;
  }

  .thoughts-shell h1 {
    font: var(--typography-display-4);
    margin: 0 0 var(--space-2);
  }

  .thoughts-shell h2 {
    font: var(--typography-display-2);
    margin: 0;
  }

  .thoughts-shell .page-intro {
    margin-bottom: var(--space-4);
  }

  .thoughts-shell .page-intro p {
    max-width: 38rem;
    color: var(--color-text-muted);
  }

  .thoughts-shell .post-list {
    display: grid;
    gap: var(--space-3);
  }

  .thoughts-shell .post-card {
    border-top: var(--border-thin) solid var(--color-border-main);
    padding-top: var(--space-2);
  }

  .thoughts-shell .post-card h2 a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .thoughts-shell .post-card h2 a:hover,
  .thoughts-shell .post-card h2 a:focus {
    color: var(--color-accent-gold);
    text-decoration: underline;
  }

  .thoughts-shell .post-meta {
    color: var(--color-text-subtle);
    font: var(--typography-label-1);
  }

  .thoughts-shell .post-description {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }

  .thoughts-shell article > header {
    margin-bottom: var(--space-4);
  }

  .thoughts-shell article > header h1 {
    margin-bottom: var(--space-2);
  }

  .thoughts-shell .post-body {
    color: var(--color-text-muted);
  }

  .thoughts-shell .post-body > :first-child {
    margin-top: 0;
  }

  .thoughts-shell .post-body > :last-child {
    margin-bottom: 0;
  }

  .thoughts-shell .post-body h2,
  .thoughts-shell .post-body h3 {
    margin-top: var(--space-3);
    color: var(--color-text-primary);
  }

  .thoughts-shell .post-body p,
  .thoughts-shell .post-body ul,
  .thoughts-shell .post-body ol,
  .thoughts-shell .post-body blockquote {
    margin-block: var(--space-2);
  }

  .thoughts-shell .post-body blockquote {
    border-left: var(--border-accent) solid var(--color-accent-primary);
    color: var(--color-text-muted);
    margin-left: 0;
    padding-left: var(--space-2);
  }

  .thoughts-shell .post-body ul,
  .thoughts-shell .post-body ol {
    padding-left: var(--space-3);
    list-style: revert;
  }

  .thoughts-shell .post-body li + li {
    margin-top: var(--space-1);
  }

  .thoughts-shell .post-body a {
    color: var(--color-accent-gold);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .thoughts-shell .post-footer {
    border-top: var(--border-thin) solid var(--color-border-main);
    margin-top: var(--space-4);
    padding-top: var(--space-2);
  }
</style>
